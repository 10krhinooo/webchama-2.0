server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # frontend/src/api/client.ts always calls a same-origin relative /api path; this is what
    # makes that resolve to the actual backend service in a deployed environment.
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA client-side routing: any path not matching a real file falls back to index.html.
    location / {
        try_files $uri /index.html;
    }
}
